<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0b101a">
  <meta name="color-scheme" content="dark">
  <%- notebook_head(page) %>
  <link rel="icon" href="/img/avatar.jpg" type="image/jpeg">
  <link rel="stylesheet" href="/css/notebook.css">
  <link rel="stylesheet" href="/css/pet.css">
  <script src="/js/notebook.js" defer></script>
  <script src="/js/pet.js" defer></script>
  <script src="/js/giscus-manager.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">jn.</span><span><%= config.title %><small>机器人 · AI · 工程记录</small></span></a>
    <nav aria-label="主导航"><% [['首页','/'],['项目','/projects/'],['文章','/archives/'],['关于','/about/']].forEach(([label,url]) => { %><a href="<%= url %>" <%- notebook_active(page) === label ? 'aria-current="page"' : '' %>><%= label %></a><% }) %></nav>
    <a class="search-link" href="/archives/#search" aria-label="搜索文章"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg></a>
  </div></header>
  <main id="main" class="container" tabindex="-1" data-page="<%= notebook_active(page) %>"><%- body %></main>
  <footer class="site-footer container"><span>© <%= new Date().getFullYear() %> 江南<span class="footer-note">把机器人调通，也把过程写清楚。</span></span><nav aria-label="更多内容"><a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/downloads/">资源</a><a href="/music/">音乐</a></nav></footer>
  <%- partial('_partial/pet') %>
</body>
</html>
