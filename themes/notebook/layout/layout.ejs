<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f7f2e8">
  <meta name="color-scheme" content="light dark">
  <%# Runs before first paint so a reader who chose dark never sees a cream flash.
      No stored choice means cream: ink-green on paper is the site's primary look. %>
  <script>try{if(localStorage.getItem('lab-theme')==='dark')document.documentElement.dataset.theme='dark'}catch(e){}</script>
  <%- notebook_head(page) %>
  <link rel="icon" href="/img/avatar.jpg" type="image/jpeg">
  <link rel="stylesheet" href="<%- notebook_versioned_asset('/css/notebook.css') %>">
  <link rel="stylesheet" href="<%- notebook_versioned_asset('/css/pet.css') %>">
  <script src="<%- notebook_versioned_asset('/js/notebook.js') %>" defer></script>
  <script src="<%- notebook_versioned_asset('/js/pet.js') %>" defer></script>
  <script src="/js/giscus-manager.js" defer></script>
  <% if (notebook_active(page) === '小记') { %>
  <link rel="stylesheet" href="<%- notebook_versioned_asset('/css/daily.css') %>">
  <script src="<%- notebook_versioned_asset('/js/daily.js') %>" defer></script>
  <% } %>
  <%# Five destinations use the same compact two-row masthead on every mobile page. %>
  <style>
    @media (max-width:760px) {
      .site-header .header-inner { display:grid; grid-template-columns:minmax(0,1fr) 36px 36px; gap:0 4px; padding-top:10px; }
      .site-header .brand { gap:10px; margin-right:0; font-size:16px; }
      .site-header .brand>span:last-child { display:block; padding-left:10px; }
      .site-header .brand small { font-size:7px; letter-spacing:.06em; }
      .site-header nav { grid-column:1/-1; grid-row:2; display:flex; width:100%; justify-content:space-between; gap:0; margin:4px 0 0; }
      .site-header nav a { min-height:44px; min-width:44px; padding-inline:10px; font-size:15px; }
      .site-header .search-link,.site-header .theme-toggle { width:36px; }
    }
    @media (max-width:360px) { .site-header .brand { font-size:14px; gap:8px; } .site-header .brand>span:last-child { padding-left:8px; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">jn.</span><span><%= config.title %><small>ROBOTICS FIELD NOTES</small></span></a>
    <nav aria-label="主导航"><% [['首页','/'],['项目','/projects/'],['文章','/archives/'],['小记','/daily/'],['关于','/about/']].forEach(([label,url]) => { %><a href="<%= url %>" <%- notebook_active(page) === label ? 'aria-current="page"' : '' %>><%= label %></a><% }) %></nav>
    <a class="search-link" href="/archives/#search" aria-label="搜索文章"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg></a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="切换到深色模式" title="切换到深色模式"><svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></svg><svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.4M12 19v2.4M2.6 12H5M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7"/></svg></button>
  </div></header>
  <main id="main" class="container" tabindex="-1" data-page="<%= notebook_active(page) %>"><%- body %></main>
  <footer class="site-footer container"><span>© <%= new Date().getFullYear() %> 江南<span class="footer-note">把机器人调通，也把过程写清楚。</span></span><nav aria-label="更多内容"><a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/downloads/">资源</a><a href="/music/">音乐</a></nav></footer>
  <%- partial('_partial/pet') %>
</body>
</html>
